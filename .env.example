# ==============================================================================
# Yapper Environment & Configuration Template
# Copy this file to .env and configure your local or production values.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Networking
# ------------------------------------------------------------------------------
# Port for the REST & Webhook server (server/api_server.js)
PORT=3000

# Base URL for the client to connect to the backend REST / SSE endpoint
API_BASE_URL=http://localhost:3000

# Web app binding port (used when debugging Flutter web)
WEB_PORT=8081

# ------------------------------------------------------------------------------
# 2. Cryptography & E2EE (Zero-Knowledge AES-GCM 256)
# ------------------------------------------------------------------------------
# Master secret salt string used in PBKDF2 100,000-iteration key derivation
E2EE_GLOBAL_SALT=yapper_e2ee_salt_v1_secure_master

# Default shared passphrase (optional; users can enter per-channel passphrases via UI)
DEFAULT_E2EE_PASSPHRASE=

# ------------------------------------------------------------------------------
# 3. Webhook Authentication
# ------------------------------------------------------------------------------
# Secret token for incoming bot webhook verification
DEFAULT_WEBHOOK_SECRET=webhook_secret_token_123

# Bearer token for authorized REST API calls (if token authorization middleware is enabled)
API_BEARER_TOKEN=yapper_bearer_token_secret_xyz

# ------------------------------------------------------------------------------
# 4. Optional Third-Party Services
# ------------------------------------------------------------------------------
# Sentry DSN for production crash and exception monitoring
SENTRY_DSN=

# Firebase / Supabase configuration (if migrating from local storage to cloud)
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_APP_ID=
